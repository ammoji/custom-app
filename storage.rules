rules_version = '2';

// Public-read for product + shop catalog images so anyone (signed-in or
// not) can browse the catalog. Writes are entirely closed off — uploads
// happen exclusively via admin scripts using a service account, which
// bypasses these rules. Any other path is denied to both reads and writes.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{filename=**} {
      allow read: if true;
      allow write: if false;
    }
    match /shops/{filename=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
