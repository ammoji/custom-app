rules_version = '2';

// Public-read for product + shop catalog images so anyone (signed-in or
// not) can browse the catalog. Writes are entirely closed off for the
// admin-managed prefixes (/products/ and /shops/) — uploads happen
// exclusively via admin scripts using a service account, which bypasses
// these rules.
//
// PR 6 adds the /menu/{shopId}/{filename} prefix for in-app shop owner
// uploads of menu item photos. Public read (same rationale as
// /products/ — anonymous customer browse paths render these directly).
// Write is gated on shopOwner claim + matching shopId so an owner can
// only write to their own shop's folder, plus a 5MB size cap and an
// image/* contentType check to keep abuse cheap.
//
// Any other path is denied to both reads and writes.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{filename=**} {
      allow read: if true;
      allow write: if false;
    }
    match /shops/{filename=**} {
      allow read: if true;
      allow write: if false;
    }
    // PR 6.1 — menu item image writes now go through the
    // `getMenuImageUploadUrl` callable, which returns a v4 signed
    // PUT URL. Admin SDK signed URLs bypass Storage rules at
    // request time (documented GCS pattern), so client writes are
    // closed entirely here.
    //
    // Why the change from PR 6: the cross-SDK auth mismatch
    // (Web SDK storage on native + RNFB auth) meant
    // `request.auth` was always null in evaluations, so the
    // claim check below could never pass. See
    // docs/pr-6.1-signed-upload-url-hotfix-windsurf-prompt.md for
    // the full root-cause writeup.
    //
    // Reads stay public — anonymous customer browse paths render
    // these images directly.
    match /menu/{shopId}/{filename} {
      allow read: if true;
      allow write: if false;
    }
    // PR 31 — Shop KYC documents (storefront photo, GST cert, FSSAI
    // license, owner ID). Same signed-PUT-URL pattern as /menu/:
    // writes go through `getShopKycUploadUrl`, which mints a v4
    // signed URL via the Admin SDK (bypasses these rules at signing
    // time). Direct client writes are denied.
    //
    // Reads are admin-only because these documents contain PII
    // (Aadhaar/PAN images, GST registration with shop address, etc).
    // The shop owner re-views their own uploads through the
    // `RegisterShopScreen` step-2 thumbnails which are local-only
    // (the `localPreviewUri` from `expo-image-picker`); we
    // deliberately do NOT mint signed-read URLs back to the owner
    // post-upload to keep the read surface tight.
    match /shop-kyc/{shopId}/{filename} {
      allow write: if false;
      allow read: if request.auth != null
                  && request.auth.token.admin == true;
    }
    // PR-NEXT-6 (findings #13, #16) — Delivery proof photos. Same
    // signed-URL pattern as /menu/ and /shop-kyc/: writes go through
    // `getDeliveryProofUploadUrl` (v4 signed PUT), reads through
    // `getDeliveryProofReadUrl` (v4 signed READ), so direct client
    // reads and writes are denied here. Read auth is role-mixed
    // (customer of the order, shop owner of the shop, admin, the
    // assigned delivery partner) which is too complex to express in
    // rules — the callable evaluates it server-side from the order
    // doc on every request.
    //
    // Path scheme: `delivery-proofs/{orderId}.jpg` (one photo per
    // order; re-upload overwrites). The catch-all below would deny
    // direct reads/writes anyway, but an explicit block keeps intent
    // visible alongside /menu/ and /shop-kyc/.
    match /delivery-proofs/{filename} {
      allow read: if false;
      allow write: if false;
    }
    // HOTFIX-PROFILE-PHOTO-2 (2026-06-10) — Delivery partner profile
    // photos. Same signed-PUT-URL pattern as /menu/ and /shop-kyc/:
    // writes go through `getPartnerPhotoUploadUrl` which bypasses
    // rules at sign time. Reads are PUBLIC because the photo is
    // surfaced to customer + shop on partner cards / live tracking
    // sheets / review screens — same rationale as /products/,
    // /shops/, /menu/. Without this rule the catch-all denies the
    // GCS public URL that DeliveryProfileScreen +
    // BecomeDeliveryPartnerScreen construct via
    // buildPartnerPhotoDownloadUrl, and Image renders blank with no
    // error event. HOTFIX-PROFILE-PHOTO fixed URL encoding; this
    // fixes the read denial that was masking under the broken
    // encoding.
    //
    // Path scheme: `delivery-profile/{uid}.jpg` (one photo per
    // partner; re-upload overwrites).
    match /delivery-profile/{filename} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
