rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    // True iff the caller's custom claims mark them as the shop owner
    // for the given shopId. Server (Cloud Functions) is the source of
    // truth — see claimShop / mergeCustomClaims in functions/src/index.ts.
    function isShopOwnerOf(shopId) {
      return isSignedIn()
             && request.auth.token.shopOwner == true
             && request.auth.token.shopId == shopId;
    }
    // Phase 12b / PR 12: any user with the delivery claim. Combined
    // with the broadened pool clause below
    // (status in {accepted, preparing, ready_for_pickup} +
    // deliveryPersonId==null), this lets delivery people see every
    // unclaimed order in the prep pipeline so they can plan ahead;
    // claiming is still gated to status==ready_for_pickup server-
    // side via claimDelivery.
    function isDeliveryPerson() {
      return isSignedIn() && request.auth.token.delivery == true;
    }
    // The specific delivery person assigned to this order. Once a
    // pickup is claimed, the unassigned-delivery clause stops matching
    // and only this assignment-specific clause keeps the doc readable.
    function isDeliveryAssignedToThisOrder() {
      return isDeliveryPerson()
             && resource.data.deliveryPersonId == request.auth.uid;
    }

    // PR 1 — security hardening: tighten /users/{uid} writes to a
    // field whitelist. The previous `allow write: if isOwner(uid)`
    // let a malicious client write `isAdmin: true`, `isDelivery: true`,
    // or other role mirrors directly. The rule never granted server-
    // side privileges (auth is gated on `request.auth.token.*`
    // CLAIMS, not these mirrors) but it leaked admin push
    // notifications (pushToAdmins looks up `users.where('isAdmin',
    // '==', true)`) and inflated the online-delivery counter the
    // getOnlineDeliveryCount callable returns.
    //
    // Allowed fields = the ones the client legitimately writes during
    // profile setup + saved-address management + FCM push setup.
    // Role mirrors and deliveryStatus are deliberately excluded;
    // those are written only by Cloud Functions via the Admin SDK
    // (which bypasses rules).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'uid', 'phone', 'phoneNumber', 'email', 'name',
             'addresses', 'defaultAddressId',
             'updatedAt', 'createdAt',
             'fcmTokens'
           ]);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'phone', 'phoneNumber', 'email', 'name',
               'addresses', 'defaultAddressId',
               'updatedAt',
               'fcmTokens'
             ]);
      allow delete: if false;
    }

    match /shops/{shopId} {
      // Phase 12a-v2-i: customers see only `active` shops. Pending
      // and rejected shops are visible to their owner (so the
      // WaitingForApproval screen works on web) and to admins (for
      // the approval dashboard). Suspended shops are admin-only.
      // Native clients route through Cloud Functions for these
      // states (listPendingShops / getMyShop), so the rule mainly
      // gates web SDK reads.
      allow read: if resource.data.status == 'active'
                  || isAdmin()
                  || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      // Cloud Functions remain the only writer (registerShop /
      // approveShop / rejectShop / claimShop[deleted]). When we ship
      // an EditShop screen post-MVP, enable a scoped update rule
      // pinning ownerUid + status so an owner can't escalate their
      // own shop back to active.
      allow write: if false;

      // PR 1 — security hardening: gate menu reads on parent shop
      // active. Previously this was unconditionally public — anyone
      // with the project's REST endpoint could scrape pending or
      // suspended shops' pricing via direct Firestore reads against
      // a fresh anon Auth token. With this gate the only public path
      // is the `listShopMenuPublic` callable, which filters identically
      // server-side. Admin reads bypass the gate.
      //
      // Performance note: `get()` inside rules counts as a doc read.
      // For an active shop's menu page this adds 1 read per menu item
      // evaluated, on top of the regular reads. Acceptable for MVP
      // scale (~34 items per shop). Revisit if shops cross 500+ items
      // — at that point we should drop direct Firestore reads on the
      // subcollection entirely and force everything through the
      // callable.
      match /menu/{menuItemId} {
        allow read: if isAdmin()
          || get(/databases/$(database)/documents/shops/$(shopId))
               .data.status == 'active';
        allow create, update, delete: if false;
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // PR 4 — collection-group rule for `menu` reads. The per-shop
    // `match /shops/{shopId}/menu/{menuItemId}` rule above only
    // matches reads scoped to a specific shopId path; a
    // collection-group query (`db.collectionGroup('menu')`) is a
    // different ruleset target and needs its own match block.
    //
    // Native customers route through the `searchMenuPublic` callable
    // for these reads (Admin SDK bypasses rules), so this rule
    // mostly governs the web SDK + admin console + future
    // snapshot-listener migration. Same active-shop predicate as the
    // per-shop rule — defense in depth, no policy drift.
    //
    // Performance note: `get()` in rules costs 1 read per evaluated
    // doc, same as the per-shop rule. Search returns ≤50 items so
    // worst case ~50 extra reads; acceptable for MVP.
    match /{path=**}/menu/{menuItemId} {
      allow read: if isAdmin()
        || (resource.data.shopId is string
            && get(/databases/$(database)/documents/shops/$(resource.data.shopId))
                 .data.status == 'active');
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      // Three readers:
      //   1. The customer who placed the order
      //   2. Any admin
      //   3. The shop owner of this order's shop (Phase 12a)
      // Native (RNFB) clients don't actually use direct Firestore reads
      // for orders — they go through listMyOrders / listShopOrders /
      // listAllOrders Cloud Functions — but the rules still gate the
      // web SDK + admin console + future snapshot-listener migration.
      allow read: if isOwner(resource.data.customerUid)
                  || isAdmin()
                  || isShopOwnerOf(resource.data.shopId)
                  || isDeliveryAssignedToThisOrder()
                  // PR 12 — broaden the delivery pool: partners now
                  // see accepted/preparing/ready_for_pickup orders
                  // that aren't yet claimed, so they can plan ahead.
                  // Claim is still gated to ready_for_pickup
                  // server-side; reading != claiming. Also note the
                  // status rename: `out_for_delivery` was renamed
                  // to `ready_for_pickup` in PR 12 (the semantic is
                  // "shop is done, awaiting delivery partner pickup";
                  // customer-facing copy still reads "Out for
                  // delivery").
                  || (isDeliveryPerson()
                      && (resource.data.status == 'accepted'
                          || resource.data.status == 'preparing'
                          || resource.data.status == 'ready_for_pickup')
                      && resource.data.deliveryPersonId == null);
      allow create, update, delete: if false;   // Cloud Functions only
    }

    // PR 2 — payment hardening. Webhook-event dedup ledger. Cloud
    // Functions write a doc per processed Razorpay event so a retry
    // (Razorpay retries on non-2xx, and any network blip can cause
    // duplicate deliveries) can short-circuit at the top of the
    // handler. Strictly server-only; clients have no business
    // reading this.
    match /razorpayWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // PR 2 — payment hardening. Refund audit ledger written by
    // cancelPaidOrder. Admins see all refunds; the user who initiated
    // a refund (admin OR shop owner of the order's shop) sees their
    // own. No client writes — Cloud Functions are the only writer
    // via Admin SDK.
    match /refunds/{refundId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.initiatedBy == request.auth.uid);
      allow write: if false;
    }

    // PR 1 — security hardening: new collection backing the
    // admin-approval flow for delivery partners (replaces the
    // self-service becomeDelivery callable). The user creates their
    // own request doc; only Cloud Functions write subsequent state.
    // Owner and admins can read; no one else.
    match /deliveryRequests/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Owner can create their own pending request. The client
      // submits via the requestDeliveryRole callable, which re-
      // validates and writes server-side; this allow lets the same
      // owner read their own doc afterwards via the web SDK if we
      // ever want to skip the polling callable. Direct creates from
      // the client with the wrong shape will still be rejected
      // because every subsequent state transition (approved /
      // rejected) is locked behind allow update: if false.
      allow create: if isOwner(uid);
      allow update, delete: if false;
    }

    // PR 8 — Admin audit log. Writes are server-only via Admin SDK
    // (writeAuditLog wrapper in functions/src/index.ts). Admin reads
    // are gated by listRecentAuditEntries callable; the rule below
    // additionally permits Firestore-console direct reads by admins
    // for incident response. No non-admin reads — even shop owners
    // can't see their own audit entries client-side; if a shop owner
    // wants to see "what admin actions affected my shop", we'll
    // build a redacted projection in a future PR.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // PR 38 + PR 38.1 — Feature usage log. Server-mediated only
    // (same posture as `aiAuditLog/` and `auditLog/`).
    //
    // PR 38 originally allowed direct client creates with a uid-
    // match check, but on native the Web SDK Firestore client
    // can't see RNFB's auth context — same root cause as PR 6.1's
    // signed-upload-URL fix for Storage. Result: client writes
    // silently failed (rule sees `request.auth == null`) and the
    // collection never accumulated data.
    //
    // PR 38.1 routes both writes and reads through callables
    // (`logFeatureUsageEvent` / `queryFeatureUsageLog`), which
    // use the Admin SDK and validate auth via the callable's
    // HTTPS auth header (works cross-SDK). Direct client ops
    // are now denied as defense-in-depth against a forged-event
    // debug client.
    match /featureUsageLog/{eventId} {
      allow read, write: if false;
    }
  }
}
