{
  "expo": {
    "name": "Kirana Mart",
    "slug": "grocery-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "grocerymvp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sudhirdavim.grocerymvp",
      "buildNumber": "1",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow grocery-mvp to use your location to find nearby shops.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sudhirdavim.grocerymvp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0E7C3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E7C3A",
          "dark": {
            "backgroundColor": "#0E7C3A"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow grocery-mvp to use your location to find nearby shops.",
          "locationWhenInUsePermission": "Allow grocery-mvp to use your location to find nearby shops.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "@sentry/react-native",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0E7C3A"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withModularHeaders"
    ],
    "experiments": {},
    "extra": {
      "eas": {
        "projectId": "25064a20-cfd6-4a98-ac27-4d435095e50a"
      }
    },
    "owner": "ammoji",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/25064a20-cfd6-4a98-ac27-4d435095e50a"
    }
  }
}
