{
  "expo": {
    "name": "Kirana Mart",
    "slug": "grocery-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "grocerymvp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sudhirdavim.grocerymvp",
      "buildNumber": "1",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kirana Mart uses your location to find nearby grocery shops.",
        "NSPhotoLibraryUsageDescription": "Kirana Mart may access your photo library when our payment provider needs to attach a receipt or proof of payment.",
        "NSPhotoLibraryAddUsageDescription": "Kirana Mart may save payment receipts to your photo library when our payment provider provides one.",
        "NSCameraUsageDescription": "Kirana Mart may use your camera when our payment provider requests it during checkout.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sudhirdavim.grocerymvp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0E7C3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E7C3A",
          "dark": {
            "backgroundColor": "#0E7C3A"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow grocery-mvp to use your location to find nearby shops.",
          "locationWhenInUsePermission": "Allow grocery-mvp to use your location to find nearby shops.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "@sentry/react-native",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0E7C3A"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withModularHeaders"
    ],
    "experiments": {},
    "extra": {
      "eas": {
        "projectId": "25064a20-cfd6-4a98-ac27-4d435095e50a"
      },
      "firebase": {
        "apiKey": "AIzaSyCM3piNPbjhICyRIYVaWyWrBplslYsVa9I",
        "authDomain": "grocery-mvp-dev.firebaseapp.com",
        "projectId": "grocery-mvp-dev",
        "storageBucket": "grocery-mvp-dev.firebasestorage.app",
        "messagingSenderId": "333323701016",
        "appId": "1:333323701016:web:a7f4014755e81b094d2c6d",
        "recaptchaSiteKey": "6Lf0G-csAAAAAPHe_99TMYVCrKlfl9qo3q1IJRe-"
      },
      "sentry": {
        "dsn": "https://b066d00d989b75e7464212453e487782@o4511383723573248.ingest.us.sentry.io/4511383731503104"
      }
    },
    "owner": "ammoji",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/25064a20-cfd6-4a98-ac27-4d435095e50a"
    }
  }
}
