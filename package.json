{
  "name": "grocery-mvp",
  "main": "App.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "seed": "tsx scripts/seed.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "set-shop-owner": "tsx scripts/set-shop-owner.ts",
    "set-delivery": "tsx scripts/set-delivery.ts",
    "backfill-menus": "tsx scripts/backfill-shop-menus.ts",
    "reset:test-data": "tsx scripts/reset-test-data.ts",
    "update-order": "tsx scripts/update-order.ts",
    "import-images": "tsx scripts/import-from-openfoodfacts.ts",
    "generate-branding": "tsx scripts/generate-branding.ts",
    "audit": "node scripts/audit-integrity.js",
    "test:rules": "firebase emulators:exec --only firestore,auth --project grocery-mvp-test \"jest --config tests/jest.config.js\"",
    "test:rules:watch": "firebase emulators:exec --only firestore,auth --project grocery-mvp-test \"jest --config tests/jest.config.js --watch\"",
    "test:unit": "jest --config tests/jest.unit.config.js",
    "test:unit:watch": "jest --config tests/jest.unit.config.js --watch",
    "test": "npm run audit && npm run test:unit",
    "test:full": "npm run audit && npm run test:unit && npm run test:rules"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/functions": "^24.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "@sentry/react-native": "~7.2.0",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.7",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native",
        "@react-navigation/native-stack"
      ]
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "firebase-admin": "^13.9.0",
    "jest": "^29.7.0",
    "sharp": "^0.34.5",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
