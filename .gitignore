# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
service-account.json
GoogleService-Info.plist
google-services.json


# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Firebase emulator + test artifacts
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
auth-debug.log
firebase-export-*/
coverage/

# Audit logs from scripts/reset-test-data.ts — keep the directory
# tracked (via .gitkeep) but never commit individual run logs.
scripts/.cleanup-logs/*
!scripts/.cleanup-logs/.gitkeep
